// Kosh — multi-tenant petty cash management.
//
// Tenant isolation rules:
//  * Every company-owned table carries `company_id`.
//  * References between company-owned rows use composite foreign keys
//    (company_id, id) so the database itself rejects cross-tenant links,
//    even if an application check is ever missed.
//  * Companies and users are never hard-deleted (codes and usernames are never reused).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum CompanyStatus {
  active
  suspended
  closed

  @@map("company_status")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

enum EntryType {
  expense
  income
  adjustment

  @@map("entry_type")
}

enum EntrySource {
  manual
  upi_screenshot
  import

  @@map("entry_source")
}

enum EntryStatus {
  draft
  submitted
  pending_approval
  approved
  rejected
  cancelled

  @@map("entry_status")
}

enum PaymentMethod {
  cash
  upi
  card
  bank_transfer
  other

  @@map("payment_method")
}

enum AttachmentKind {
  upi_screenshot
  receipt
  bill
  invoice
  other

  @@map("attachment_kind")
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

model Company {
  id          String        @id @default(uuid(7)) @db.Uuid
  companyCode String        @unique @map("company_code") @db.VarChar(12)
  name        String        @map("company_name") @db.VarChar(120)
  ownerUserId String?       @unique @map("owner_user_id") @db.Uuid
  status      CompanyStatus @default(active)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner         User?            @relation("CompanyOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  settings      CompanySettings?
  users         User[]           @relation("CompanyUsers")
  roles         Role[]
  categories    Category[]
  cashAccounts  CashAccount[]
  entries       PettyCashEntry[]
  attachments   Attachment[]
  auditLogs     AuditLog[]
  sessions      Session[]
  notifications Notification[]
  invitations   Invitation[]
  counters      CompanyCounter[]

  @@map("companies")
}

model CompanySettings {
  companyId               String   @id @map("company_id") @db.Uuid
  currency                String   @default("INR") @db.Char(3)
  timezone                String   @default("Asia/Kolkata") @db.VarChar(64)
  /// 1 = January … 12 = December. Indian financial year starts in April.
  financialYearStartMonth Int      @default(4) @map("financial_year_start_month") @db.SmallInt
  defaultCashAccountId    String?  @map("default_cash_account_id") @db.Uuid
  approvalRequired        Boolean  @default(true) @map("approval_required")
  receiptRequired         Boolean  @default(false) @map("receipt_required")
  maxExpenseLimit         Decimal? @map("max_expense_limit") @db.Decimal(14, 2)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company            Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  defaultCashAccount CashAccount? @relation(fields: [companyId, defaultCashAccountId], references: [companyId, id], onDelete: Restrict)

  @@map("company_settings")
}

/// Per-company monotonically increasing counters (e.g. entry numbers per year).
model CompanyCounter {
  companyId String @map("company_id") @db.Uuid
  name      String @db.VarChar(32)
  value     Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([companyId, name])
  @@map("company_counters")
}

// ─── Identity & access ──────────────────────────────────────────────────────

model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  companyId         String     @map("company_id") @db.Uuid
  /// Stored lower-cased; unique within a company.
  username          String     @db.VarChar(32)
  email             String?    @db.VarChar(254)
  fullName          String     @map("full_name") @db.VarChar(120)
  passwordHash      String     @map("password_hash")
  roleId            String     @map("role_id") @db.Uuid
  status            UserStatus @default(active)
  avatarPath        String?    @map("avatar_path") @db.VarChar(512)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  createdById       String?    @map("created_by") @db.Uuid
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  company        Company              @relation("CompanyUsers", fields: [companyId], references: [id], onDelete: Restrict)
  role           Role                 @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Restrict)
  ownedCompany   Company?             @relation("CompanyOwner")
  sessions       Session[]
  refreshTokens  RefreshToken[]
  resetTokens    PasswordResetToken[]
  loginAttempts  LoginAttempt[]
  notifications  Notification[]
  createdEntries PettyCashEntry[]     @relation("EntryCreatedBy")
  verifiedEntries PettyCashEntry[]    @relation("EntryVerifiedBy")
  approvedEntries PettyCashEntry[]    @relation("EntryApprovedBy")
  rejectedEntries PettyCashEntry[]    @relation("EntryRejectedBy")
  attachments    Attachment[]
  invitationsSent Invitation[]

  @@unique([companyId, username])
  @@unique([companyId, id])
  @@index([companyId, status])
  @@index([companyId, roleId])
  @@map("users")
}

model Role {
  id           String   @id @default(uuid(7)) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  /// Stable key for system roles (owner, admin, accountant, cashier, viewer); null for custom roles.
  key          String?  @db.VarChar(32)
  name         String   @db.VarChar(50)
  description  String?  @db.VarChar(255)
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  users       User[]
  permissions RolePermission[]
  invitations Invitation[]

  @@unique([companyId, name])
  @@unique([companyId, key])
  @@unique([companyId, id])
  @@map("roles")
}

/// Global permission catalogue (not company-owned). Kept in sync with src/config/permissions.ts.
model Permission {
  id            String   @id @default(uuid(7)) @db.Uuid
  key           String   @unique @map("permission_key") @db.VarChar(64)
  description   String   @db.VarChar(255)
  group         String   @map("permission_group") @db.VarChar(32)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// A login session. Each session is one refresh-token family.
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  /// Absolute lifetime — rotation can never extend a session beyond this.
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(32)
  lastUsedAt    DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  ipAddress     String?   @map("ip_address") @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(512)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([companyId])
  @@map("sessions")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Token family == session. Reuse of a rotated token revokes the whole family.
  sessionId    String    @map("token_family") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// SHA-256 of the opaque token. The raw token only ever lives in the HttpOnly cookie.
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  requestedIp String?   @map("requested_ip") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Every login attempt (success or failure). Drives lockout and the login-history screen.
model LoginAttempt {
  id            String   @id @default(uuid(7)) @db.Uuid
  companyId     String?  @map("company_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  companyCode   String   @map("company_code") @db.VarChar(12)
  username      String   @db.VarChar(64)
  success       Boolean
  failureReason String?  @map("failure_reason") @db.VarChar(32)
  ipAddress     String?  @map("ip_address") @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(512)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([companyCode, username, createdAt(sort: Desc)])
  @@map("login_attempts")
}

/// Fixed-window rate-limit counters shared by all app instances.
model RateLimit {
  key     String   @id @db.VarChar(200)
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  @@index([resetAt])
  @@map("rate_limits")
}

/// Future-ready: invite users by email instead of creating them directly.
model Invitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  email       String    @db.VarChar(254)
  roleId      String    @map("role_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  invitedById String    @map("invited_by") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  role      Role    @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Restrict)
  invitedBy User    @relation(fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([companyId, email])
  @@map("invitations")
}

// ─── Petty cash ─────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String   @db.VarChar(60)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  entries PettyCashEntry[]

  @@unique([companyId, name])
  @@unique([companyId, id])
  @@map("categories")
}

model CashAccount {
  id             String   @id @default(uuid(7)) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  name           String   @db.VarChar(60)
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(14, 2)
  /// Maintained transactionally by the server: opening + approved income − approved expenses ± adjustments.
  currentBalance Decimal  @default(0) @map("current_balance") @db.Decimal(14, 2)
  currency       String   @default("INR") @db.Char(3)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  entries         PettyCashEntry[]
  defaultSettings CompanySettings[]

  @@unique([companyId, name])
  @@unique([companyId, id])
  @@map("cash_accounts")
}

model PettyCashEntry {
  id              String        @id @default(uuid(7)) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  cashAccountId   String        @map("cash_account_id") @db.Uuid
  createdById     String        @map("created_by") @db.Uuid
  verifiedById    String?       @map("verified_by") @db.Uuid
  approvedById    String?       @map("approved_by") @db.Uuid
  rejectedById    String?       @map("rejected_by") @db.Uuid
  /// Human-readable, unique per company: PC-2026-000001
  entryNumber     String        @map("entry_number") @db.VarChar(20)
  entryDate       DateTime      @map("entry_date") @db.Date
  /// Local wall-clock time "HH:mm" in the company timezone.
  entryTime       String?       @map("entry_time") @db.VarChar(5)
  type            EntryType
  /// Always positive for expense/income. Signed for adjustments (+ increases, − decreases the balance).
  amount          Decimal       @db.Decimal(14, 2)
  currency        String        @default("INR") @db.Char(3)
  categoryId      String?       @map("category_id") @db.Uuid
  description     String?       @db.VarChar(500)
  paymentMethod   PaymentMethod @map("payment_method")
  merchantName    String?       @map("merchant_name") @db.VarChar(120)
  upiId           String?       @map("upi_id") @db.VarChar(120)
  /// External payment reference (UPI transaction ID / UTR etc.).
  transactionId   String?       @map("transaction_id") @db.VarChar(64)
  referenceNumber String?       @map("reference_number") @db.VarChar(64)
  source          EntrySource   @default(manual)
  status          EntryStatus   @default(draft)
  rejectionReason String?       @map("rejection_reason") @db.VarChar(500)
  submittedAt     DateTime?     @map("submitted_at") @db.Timestamptz(3)
  verifiedAt      DateTime?     @map("verified_at") @db.Timestamptz(3)
  approvedAt      DateTime?     @map("approved_at") @db.Timestamptz(3)
  /// True when approval was not required by company settings at submission time.
  autoApproved    Boolean       @default(false) @map("auto_approved")
  rejectedAt      DateTime?     @map("rejected_at") @db.Timestamptz(3)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(3)
  deletedById     String?       @map("deleted_by") @db.Uuid
  /// Optimistic-concurrency version; every write must match and increment it.
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  cashAccount CashAccount  @relation(fields: [companyId, cashAccountId], references: [companyId, id], onDelete: Restrict)
  category    Category?    @relation(fields: [companyId, categoryId], references: [companyId, id], onDelete: Restrict)
  createdBy   User         @relation("EntryCreatedBy", fields: [companyId, createdById], references: [companyId, id], onDelete: Restrict)
  verifiedBy  User?        @relation("EntryVerifiedBy", fields: [companyId, verifiedById], references: [companyId, id], onDelete: Restrict)
  approvedBy  User?        @relation("EntryApprovedBy", fields: [companyId, approvedById], references: [companyId, id], onDelete: Restrict)
  rejectedBy  User?        @relation("EntryRejectedBy", fields: [companyId, rejectedById], references: [companyId, id], onDelete: Restrict)
  attachments Attachment[]

  @@unique([companyId, entryNumber])
  @@unique([companyId, id])
  @@index([companyId, entryDate(sort: Desc)])
  @@index([companyId, status])
  @@index([companyId, categoryId])
  @@index([companyId, createdById])
  @@index([companyId, transactionId])
  @@index([companyId, cashAccountId, status])
  @@index([companyId, status, entryDate(sort: Desc)])
  @@index([companyId, deletedAt, entryDate(sort: Desc), createdAt(sort: Desc)])
  @@map("petty_cash_entries")
}

model Attachment {
  id           String         @id @default(uuid(7)) @db.Uuid
  companyId    String         @map("company_id") @db.Uuid
  entryId      String?        @map("transaction_id") @db.Uuid
  uploadedById String         @map("uploaded_by") @db.Uuid
  kind         AttachmentKind @default(receipt)
  fileName     String         @map("file_name") @db.VarChar(255)
  fileType     String         @map("file_type") @db.VarChar(100)
  fileSize     Int            @map("file_size")
  /// Randomised object key in storage — never derived from the uploaded filename.
  storagePath  String         @unique @map("storage_path") @db.VarChar(512)
  sha256       String?        @db.Char(64)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  entry      PettyCashEntry? @relation(fields: [companyId, entryId], references: [companyId, id], onDelete: Restrict)
  uploadedBy User            @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([companyId, entryId])
  @@index([companyId, sha256])
  @@map("attachments")
}

// ─── Activity ───────────────────────────────────────────────────────────────

/// Append-only (enforced by a database trigger). user_id intentionally has no FK
/// so the trail survives any future user-data erasure.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(32)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, entityType, entityId])
  @@index([companyId, userId])
  @@map("audit_logs")
}

model Notification {
  id         String    @id @default(uuid(7)) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String    @db.VarChar(64)
  title      String    @db.VarChar(200)
  body       String?   @db.VarChar(1000)
  entityType String?   @map("entity_type") @db.VarChar(32)
  entityId   String?   @map("entity_id") @db.VarChar(64)
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [companyId, userId], references: [companyId, id], onDelete: Restrict)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}
