# ─────────────────────────────────────────────────────────────────────────────
# Kosh — environment variables. Copy to `.env` and fill in.
# `.env` is git-ignored; never commit real values.
# See SUPABASE_SETUP.md for where each Supabase value comes from.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime connection used by the app — Supabase "Transaction pooler" (port 6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Migrations / Prisma CLI — Supabase "Session pooler" (port 5432) or the direct connection.
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase CA certificate (PEM) so the app verifies the database's TLS certificate.
# Paste the file contents on one line with literal \n between lines.
DATABASE_SSL_CA=""

# Max connections per app instance. Keep small on serverless (e.g. 3–5); the pooler multiplexes.
DATABASE_POOL_MAX="5"

# Public URL of the app (used for password-reset links and CSRF origin checks).
APP_URL="http://localhost:3000"

# Signing key for short-lived access tokens. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=""

# Token lifetimes (defaults shown).
ACCESS_TOKEN_TTL_MINUTES="15"
REFRESH_TOKEN_TTL_DAYS="7"
SESSION_MAX_AGE_DAYS="30"

# Optional: SMTP server for password-reset emails (sent with Nodemailer).
# Without SMTP_HOST, reset links are printed to the server log in development.
# Port 465 uses TLS from the start; other ports upgrade with STARTTLS (required in production).
# Set SMTP_SECURE="true" or "false" only to override that.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Kosh <no-reply@yourdomain.com>"

# Receipts and UPI screenshots — Supabase Storage (private bucket; see SUPABASE_SETUP.md, step 9).
# Required in production. The service key is a secret: server-only, never NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="attachments"
# Or keep files on local disk (development / single-server hosting). Defaults to .data/uploads in development.
# UPLOAD_DIR=""
